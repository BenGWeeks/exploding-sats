# LNbits configuration for Exploding Sats
# These are embedded at build time (Vite)

# LNbits instance that hosts the receiving wallet
VITE_LNBITS_URL=https://your-lnbits-instance.example

# Invoice/Read key from the LNbits wallet (can only create invoices and check status)
VITE_LNBITS_INVOICE_KEY=your_invoice_key_here

# Lightning address (LNURL-pay) that receives the 21 sats per game
VITE_LIGHTNING_ADDRESS=your.game@your-lnbits-instance.example

# Game Nostr pubkey (hex) used to query the leaderboard - derived from GAME_NSEC
VITE_GAME_PUBKEY=<64-char-hex-pubkey>

# Score service only (.env.local): game Nostr private key used to sign scores
# GAME_NSEC=nsec1...
