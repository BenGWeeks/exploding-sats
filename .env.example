# Exploding Sats configuration

# --- Score service (runtime; put these in .env.local for `npm run dev`) ---

# Game Nostr private key used to sign scores
# GAME_NSEC=nsec1...

# Lightning payments are created and checked server-side by the score service,
# so the LNbits key never reaches the browser. Runtime only - never a VITE_ var.
LIGHTNING_ADDRESS=your.game@your-lnbits-instance.example
LNBITS_URL=https://your-lnbits-instance.example
# Invoice/read key of the wallet behind LIGHTNING_ADDRESS (used to check payment status)
LNBITS_INVOICE_KEY=changeme_invoice_key

# --- Frontend (build time, embedded in the public bundle: public values only) ---

# Game Nostr pubkey (hex) used to query the leaderboard - derived from GAME_NSEC
VITE_GAME_PUBKEY=<64-char-hex-pubkey>

# Lightning address shown on the payment screen (display only)
VITE_LIGHTNING_ADDRESS=your.game@your-lnbits-instance.example
